<odoo>
    <!--the list view record-->
    <record id = "owner_view_tree" model="ir.ui.view">
        <field name="name">Owner Tree</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <!--the model "owner" fields to show it in the list view-->
            <list>
                <field name="name"/>
                <field name="property_ids"/>
                <field name="phone"/>
                <field name="address"/>
            </list>
        </field>
    </record>

    <!--the form view record-->
    <record id = "owner_view_form" model="ir.ui.view">
        <field name="name">Owner Form</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <!--the model "owner" fields-->
            <form>
                <sheet>
                    <!--make the "Name" to header of the page-->
                    <div class ="oe_title">
                        <label for = "name"/>
                        <h1>
                            <field name="name" placeholder="Enter your name"/>
                        </h1>
                    </div>
                    <group>
                        <!--group General Info. for data-->
                        <group string  = "General Info.">
                            <field name="phone" placeholder="phone"/>
                            <field name="address" placeholder="address"/>
                        </group>
                        <group string="Property">
                            <field name="property_ids" widget = "many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--menu action record for third level menu-->
    <record id="owner_action" model="ir.actions.act_window">
        <field name = "name">Owner data</field>
        <field name = "res_model">owner</field>
    </record>

    <!--the 4th level menu Architecture-->
    <menuitem
        id = "owner_menu_item_01"
        name = "Owners"
        parent = "owner_menu_root"
        action  = "owner_action"
    />
</odoo>