<odoo>
    <!--the list view record-->
    <record id = "property_view_tree" model="ir.ui.view">
        <field name="name">Property Tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <!--the model "property" fields to show it in the list view-->
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="post_code"/>
                <field name="date_availability"/>
                <field name="expected_price" optional="show"/>
                <field name="selling_price" optional="show"/>
                <field name="bed_rooms" optional="1"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="gardian_area"/>
                <field name="gardian_oriantaition"/>
            </list>
        </field>
    </record>

    <!--the form view record-->
    <record id = "property_view_form" model="ir.ui.view">
        <field name="name">Property Form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <!--the model "property" fields-->
            <form>
                <sheet>
                    <!--make the "Name" to header of the page-->
                    <div class ="oe_title">
                        <label for = "name"/>
                        <h1>
                            <field name="name" placeholder="Enter your name"/>
                        </h1>
                    </div>
                    <group>
                        <!--group General Info. for data-->
                        <group string  = "General Info.">
                            <field name="description" placeholder="Description"/>
                            <field name="post_code" placeholder="Post Code"/>
                            <field name="expected_price" placeholder="Expected Price"/>
                            <field name="selling_price" placeholder="Selling Price"/>
                            <field name="date_availability" placeholder="Date Availability"/>
                        </group>

                        <!--group Additional Info. for data-->
                        <group string  = "Additional Info.">
                            <field name="bed_rooms" placeholder="Number of Bedrooms"/>
                            <field name="living_area" placeholder="Living Area"/>
                            <field name="garage" placeholder="Has Garage"/>
                        </group>
                    </group>

                    <!--group gardian-->
                    <group string="gardian">
                        <field name="gardian_area"/>
                        <field name="gardian_oriantaition"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--the search view record-->
    <record id = "property_view_search" model="ir.ui.view">
        <field name="name">Property Search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <!--fields to search with it in search bar-->
                <field name="name"/>
                <field name="post_code"/>
                <field name="description"/>

                <!--filters to use it, like with garage, Price Range, ...etc-->
                <filter name="is_garage" string="With garage" domain="[('garage','=','set')]"/>
                <filter name="is_not_garage" string="Without garage" domain="[('garage','!=','True')]"/>
                <filter name="Expected_Price_Range" string="Price Range" domain="[('expected_price','>=','75000')]"/>

                <!--groups to use it, like have a garage-->
                <filter name="Group_by_Garage" string="Group by Garage" context="{'group_by':'garage'}"/>
            </search>
        </field>
    </record>

    <!--menu action record for third level menu-->
    <record id="property_action" model="ir.actions.act_window">
        <field name = "name">Flats data</field>
        <field name = "res_model">property</field>
    </record>

    <!--the third level menu Architecture-->
    <menuitem
        id = "property_menu_item"
        name = "Property 03 level"
        parent = "property_menu_root"
        action  = "property_action"
    />
</odoo>