<odoo>
    <!--the list view record-->
    <record id = "property_view_tree" model="ir.ui.view">
        <field name="name">Property Tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <!--the model "property" fields-->
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="post_code"/>
                <field name="date_availability"/>
                <field name="expected_price" optional="show"/>
                <field name="selling_price" optional="show"/>
                <field name="bed_rooms" optional="1"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="gardian_area"/>
                <field name="gardian_oriantaition"/>
            </list>
        </field>
    </record>

    <!--the third level menu action record-->
    <record id="property_action" model="ir.actions.act_window">
        <field name = "name">Property Action</field>
        <field name = "res_model">property</field>
    </record>

    <!--the third level menu Architecture-->
    <menuitem
        id = "property_menu_item"
        name = "Property 03 level"
        parent = "property_menu_root"
        action  = "property_action"
    />
</odoo>